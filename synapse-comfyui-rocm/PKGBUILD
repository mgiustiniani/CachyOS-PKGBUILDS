# Maintainer: Mario Giustiniani <mariogiustiniani@gmail.com>

pkgname=synapse-comfyui-rocm
pkgver=0.28.0
pkgrel=5
pkgdesc='Node-based ComfyUI visual generation workflows for Radeon ROCm'
arch=('x86_64')
url='https://github.com/Comfy-Org/ComfyUI'
license=('GPL-3.0-only')
backup=('etc/synapse/comfyui/config.conf')

depends=(
  'bash' 'python' 'python-pytorch-opt-rocm' 'python-torchvision'
  'synapse-python-torchaudio-rocm' 'python-numpy' 'python-transformers'
  'python-tokenizers' 'python-sentencepiece' 'python-safetensors'
  'python-aiohttp' 'python-yarl' 'python-yaml' 'python-pillow' 'python-scipy'
  'python-tqdm' 'python-psutil' 'python-alembic' 'python-sqlalchemy'
  'python-filelock' 'python-av' 'python-requests' 'python-pydantic'
  'python-pydantic-settings' 'python-blake3' 'rocm-core'
)
makedepends=('git' 'uv')

_comfy_commit='700821e1364eaab0e8f21c538a2131719fec57bf'
source=(
  "ComfyUI::git+https://github.com/Comfy-Org/ComfyUI.git#commit=${_comfy_commit}"
  'config.conf' 'synapse-comfyui' 'synapse-comfyui-doctor' 'synapse-comfyui.service' 'sitecustomize.py' 'README.md'
)
sha256sums=(
  'SKIP'
  'd8d45a63467dfa9d6443eaa2cd069b8c3c2dc8ecfe0cb61a4513de08c9a286ed'
  'ff2ca4bd41d4162611cec9ae9c17428c376aadb16bd167c74a4d5af850114c8f'
  '17f71bf7d1fe69a35ac11b26d68b41768a0b08fa28c88899cb3cb62f25a029eb'
  '2c3f47244c9435d9c5cf9fb13e4806330aaf1bdd50b2ebd786101066d237341e'
  'aaf933256cce52d58c17968e4383e4a1cc827e16701d8ccf4074f66f30b8c2a1'
  '337903c93b3562c6ffcff5af3c61fb490369ec6c87cace7a3bf6f09485f5079b'
)

build() {
  local vendor="$srcdir/python-vendor"
  rm -rf "$vendor" && mkdir -p "$vendor"
  UV_LINK_MODE=copy uv pip install --python /usr/bin/python --target "$vendor" --no-deps \
    'comfyui-frontend-package==1.45.21' 'comfyui-workflow-templates==0.11.9' \
    'comfyui-embedded-docs==0.5.8' 'torchsde' 'trampoline' 'einops' \
    'comfyui-workflow-templates-core==0.3.272' \
    'comfyui-workflow-templates-json==0.1.6' \
    'comfy-kitchen==0.2.20' 'comfy-aimdo==0.4.10' 'simpleeval>=1.0.0' \
    'kornia>=0.7.1' 'kornia-rs>=0.1.9' 'spandrel' 'PyOpenGL>=3.1.8' 'comfy-angle'
  rm -rf "$vendor/bin" "$vendor/.lock"
}

package() {
  local app="$pkgdir/usr/lib/synapse-comfyui"
  install -dm755 "$app/python"
  cp -a "$srcdir/python-vendor/." "$app/python/"
  cp -a "$srcdir/ComfyUI" "$app/ComfyUI"
  rm -rf "$app/ComfyUI/.git" "$app/ComfyUI/models" "$app/ComfyUI/output" \
         "$app/ComfyUI/input" "$app/ComfyUI/user"
  find "$app" -type d -name '__pycache__' -prune -exec rm -rf {} +
  find "$app" -type f \( -name '*.safetensors' -o -name '*.onnx' -o -name '*.pt' -o -name '*.bin' \) -delete

  install -Dm644 "$srcdir/sitecustomize.py" "$app/sitecustomize.py"
  install -Dm755 "$srcdir/synapse-comfyui" "$pkgdir/usr/bin/synapse-comfyui"
  install -Dm755 "$srcdir/synapse-comfyui-doctor" "$pkgdir/usr/bin/synapse-comfyui-doctor"
  install -Dm644 "$srcdir/config.conf" "$pkgdir/etc/synapse/comfyui/config.conf"
  install -Dm644 "$srcdir/synapse-comfyui.service" "$pkgdir/usr/lib/systemd/user/synapse-comfyui.service"
  install -dm755 "$pkgdir/var/lib/synapse/comfyui/models"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$srcdir/ComfyUI/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
