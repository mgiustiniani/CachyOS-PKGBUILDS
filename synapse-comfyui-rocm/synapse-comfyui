#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-only
set -euo pipefail
config=/etc/synapse/comfyui/config.conf
[[ -r "$config" ]] && source "$config"
model_root=${COMFYUI_MODEL_ROOT:-/var/lib/synapse/comfyui/models}
output_root=${COMFYUI_OUTPUT_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/synapse/comfyui/output}
input_root=${COMFYUI_INPUT_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/synapse/comfyui/input}
user_root=${COMFYUI_USER_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/synapse/comfyui/user}
temp_root=${XDG_CACHE_HOME:-$HOME/.cache}/synapse/comfyui/temp
listen=${COMFYUI_LISTEN:-127.0.0.1}
port=${COMFYUI_PORT:-8188}
mkdir -p "$model_root" "$output_root" "$input_root" "$user_root" "$temp_root" "${XDG_CACHE_HOME:-$HOME/.cache}/synapse/comfyui"
paths="${XDG_CACHE_HOME:-$HOME/.cache}/synapse/comfyui/extra_model_paths.yaml"
/usr/bin/python /usr/lib/synapse-comfyui/comfyui_model_paths.py \
  --model-root "$model_root" --output "$paths"
workflow_dir="$user_root/default/workflows"
mkdir -p "$workflow_dir"
if [[ ! -e "$workflow_dir/synapse-z-image-turbo.json" ]]; then
  cp /usr/share/synapse/comfyui/workflows/z-image-turbo.json \
    "$workflow_dir/synapse-z-image-turbo.json"
fi
if [[ ! -e "$workflow_dir/synapse-minimax-h3-native-t2v.json" ]]; then
  cp /usr/share/synapse/comfyui/workflows/minimax-h3-native-t2v.json \
    "$workflow_dir/synapse-minimax-h3-native-t2v.json"
fi
export PYTHONPATH="/usr/lib/synapse-comfyui/python:/usr/lib/synapse-comfyui${PYTHONPATH:+:$PYTHONPATH}"
export PYTORCH_HIP_ALLOC_CONF=${PYTORCH_HIP_ALLOC_CONF:-expandable_segments:True}
exec /usr/bin/python /usr/lib/synapse-comfyui/ComfyUI/main.py \
  --extra-model-paths-config "$paths" --output-directory "$output_root" \
  --input-directory "$input_root" --user-directory "$user_root" --temp-directory "$temp_root" \
  --database-url "sqlite:///$user_root/comfyui.db" \
  --listen "$listen" --port "$port" \
  --use-pytorch-cross-attention "$@"
