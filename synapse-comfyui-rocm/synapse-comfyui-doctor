# SPDX-License-Identifier: GPL-3.0-only
import json
import os
import pathlib
import sys

try:
    import torch
    hip = torch.version.hip
    gpu = torch.cuda.is_available() and bool(hip)
    device = torch.cuda.get_device_name(0) if gpu else None
except Exception as exc:
    hip = None
    gpu = False
    device = None
    error = str(exc)
root = pathlib.Path(os.environ.get("COMFYUI_MODEL_ROOT", "/var/lib/synapse/comfyui/models"))
result = {
    "schema_version": 1,
    "status": "ready" if gpu and pathlib.Path("/usr/lib/synapse-comfyui/ComfyUI/main.py").is_file() else "degraded",
    "rocm": {"available": gpu, "hip": hip, "device": device},
    "runtime": "/usr/lib/synapse-comfyui/ComfyUI",
    "model_root": str(root),
    "model_root_exists": root.is_dir(),
}
if 'error' in locals(): result["error"] = error
print(json.dumps(result, ensure_ascii=False, sort_keys=True))
sys.exit(0 if result["status"] == "ready" else 1)
