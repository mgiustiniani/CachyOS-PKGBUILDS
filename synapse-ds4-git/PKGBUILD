# Maintainer: Mario Giustiniani <mariogiustiniani@gmail.com>
# Contributor: Salvatore Sanfilippo <antirez@gmail.com> (upstream author)

pkgname=synapse-ds4-git
pkgver=0.0.0
pkgrel=2
pkgdesc='Synapse DeepSeek 4 inference engine — ROCm Strix Halo git build'
arch=('x86_64')
url='https://github.com/antirez/ds4'
license=('LicenseRef-Antirez-DS4')
depends=(
    'bash'
    'hipblas'
    'hipblaslt'
    'rocblas'
    'rocwmma'
    'rocminfo'
    'rocm-smi-lib'
    'synapse-ds4-launcher>=0.1.0'
    'synapse-model-manager>=0.4.0'
)
makedepends=('git' 'gcc' 'hipcc' 'comgr')
provides=('ds4' 'ds4-git')
conflicts=('ds4' 'ds4-git')
replaces=('ds4-git')
backup=('etc/ds4/config' 'etc/ds4/server.conf')
source=(
    'ds4::git+https://github.com/antirez/ds4.git'
    'synapse-ds4-server'
    'test_synapse_ds4_server.sh'
)
sha256sums=(
    'SKIP'
    '4cc1878b1f9556434c7a31eaf7fdd6ecd7d2dc25a7c3de3a8a7019172fd8fb1c'
    '1b180ceaeec788134da590c15848ae511e7f93c970e0f743c49db6632f9410c1'
)

prepare() {
    cd "$srcdir"
}

pkgver() {
    cd "$srcdir/ds4"
    git describe --always --long --tags 2>/dev/null || echo "0.0.0"
}

build() {
    cd "$srcdir/ds4"

    # Build ROCm target for Strix Halo (gfx1151)
    make -B ds4 ds4-server ds4-bench ds4-eval ds4-agent \
        CORE_OBJS="ds4.o ds4_distributed.o ds4_ssd.o ds4_rocm.o" \
        CFLAGS="$(CFLAGS) -DDS4_ROCM_BUILD" \
        DS4_LINK="hipcc -O3 -ffast-math -g -fno-finite-math-only -pthread -D__HIP_PLATFORM_AMD__ -Wno-unused-command-line-argument --offload-arch=gfx1151" \
        DS4_LINK_LIBS="-lm -pthread -lhipblas -lhipblaslt" \
        LDLIBS="-lm -pthread" \
        CC="gcc" \
        OBJCFLAGS="" \
        HIPCC="hipcc" \
        ROCM_CFLAGS="-O3 -ffast-math -g -fno-finite-math-only -pthread -D__HIP_PLATFORM_AMD__ -Wno-unused-command-line-argument --offload-arch=gfx1151" \
        ROCM_LDLIBS="-lm -pthread -lhipblas -lhipblaslt" \
        NVCC="echo" \
        CUDA_HOME=""

    # Build gguf-tools (quantization tool)
    make -C gguf-tools deepseek4-quantize \
        CC="gcc" \
        CFLAGS="-O3 -Wall -Wextra -std=c11 -march=native" \
        CPPFLAGS="-D_GNU_SOURCE"
}

check() {
    cd "$srcdir/ds4"
    ./ds4-eval --self-test-extractors
    bash -n "$srcdir/synapse-ds4-server"
    sh "$srcdir/test_synapse_ds4_server.sh" "$srcdir/synapse-ds4-server"
}

package() {
    cd "$srcdir/ds4"

    # ── Binaries ──────────────────────────────────────────────
    install -Dm755 ds4 -t "$pkgdir/usr/bin/"
    install -Dm755 ds4-server -t "$pkgdir/usr/bin/"
    install -Dm755 ds4-bench -t "$pkgdir/usr/bin/"
    install -Dm755 ds4-eval -t "$pkgdir/usr/bin/"
    install -Dm755 ds4-agent -t "$pkgdir/usr/bin/"

    # ── gguf-tools ────────────────────────────────────────────
    install -Dm755 gguf-tools/deepseek4-quantize "$pkgdir/usr/bin/deepseek4-quantize"
    install -Dm644 gguf-tools/quants.h -t "$pkgdir/usr/include/ds4/"
    install -Dm644 gguf-tools/README.md -t "$pkgdir/usr/share/doc/ds4/gguf-tools/"

    # ── Model download script ─────────────────────────────────
    install -Dm755 download_model.sh "$pkgdir/usr/bin/ds4-download-model"

    # ── Config directory ──────────────────────────────────────
    mkdir -p "$pkgdir/etc/ds4"

    cat > "$pkgdir/etc/ds4/config" <<'CONFIGEOF'
# DS4 configuration — sourced by wrapper scripts
# Edit this file to change default settings

# Verified model paths managed by synapse-model-manager.
MODEL_BUNDLE=ds4-q2-imatrix
MODEL_PATH=/var/lib/synapse/models/gguf/deepseek4-flash-284B-GGUF/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf

# MTP speculative decoding model (optional).
MTP_PATH=/var/lib/synapse/models/gguf/deepseek4-flash-284B-GGUF/DeepSeek-V4-Flash-MTP-Q4K-Q8_0-F32.gguf
MTP_DRAFT_TOKENS=2

# ROCm backend
BACKEND=rocm
POWER=100

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_CTX=100000
SERVER_TOKENS=30000
SERVER_KV_DIR=/var/lib/ds4/kv/server
SERVER_KV_MB=8192

# Generation defaults
TEMPERATURE=1.0
TOP_P=1.0
MIN_P=0.05
THINK=high
CONFIGEOF

    cat > "$pkgdir/etc/ds4/server.conf" <<'SERVEREOF'
# Human-readable ds4-server policy reference.
# The service consumes /etc/ds4/config through synapse-ds4-server.
model_bundle=ds4-q2-imatrix
model_path=/var/lib/synapse/models/gguf/deepseek4-flash-284B-GGUF/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf
host=127.0.0.1
port=8000
ctx=100000
tokens=30000
kv_dir=/var/lib/ds4/kv/server
kv_mb=8192
quality=true
cors=true

# MTP speculative decoding (optional)
mtp_path=/var/lib/synapse/models/gguf/deepseek4-flash-284B-GGUF/DeepSeek-V4-Flash-MTP-Q4K-Q8_0-F32.gguf
mtp_draft=2
SERVEREOF

    # ── Systemd service ───────────────────────────────────────
    mkdir -p "$pkgdir/usr/lib/systemd/system"
    cat > "$pkgdir/usr/lib/systemd/system/ds4-server.service" <<'SERVEOF'
[Unit]
Description=DS4 LLM inference server (ROCm Strix Halo)
After=network.target
Wants=network.target

[Service]
Type=simple
EnvironmentFile=/etc/ds4/config
ExecStartPre=/usr/bin/synapse-ds4-server --dry-run
ExecStart=/usr/bin/synapse-ds4-server
Restart=on-failure
RestartSec=60
User=root
RuntimeDirectory=ds4
StateDirectory=ds4
WorkingDirectory=/var/lib/ds4
# ROCm environment
Environment=HSA_ENABLE_GPU_RECOVERY=1
Environment=HSA_OVERRIDE_GFX_VERSION=1151

[Install]
WantedBy=multi-user.target
SERVEOF

    # ── Wrapper script ────────────────────────────────────────
    cat > "$pkgdir/usr/bin/ds4-run" <<'WRAPPEREOF'
#!/usr/bin/env bash
# DS4 wrapper — sources /etc/ds4/config
set -euo pipefail

CONFIG=/etc/ds4/config
if [ -f "$CONFIG" ]; then
    . "$CONFIG"
fi

# Build args
ARGS=()
ARGS+=(--model "${MODEL_PATH:-/var/lib/synapse/models/gguf/deepseek4-flash-284B-GGUF/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix.gguf}")
ARGS+=(--backend "${BACKEND:-rocm}")

# MTP speculative decoding
if [ -n "${MTP_PATH:-}" ] && [ -f "$MTP_PATH" ]; then
    ARGS+=(--mtp "$MTP_PATH")
    ARGS+=(--mtp-draft "${MTP_DRAFT_TOKENS:-2}")
fi

exec /usr/bin/ds4 "${ARGS[@]}" "$@"
WRAPPEREOF
    chmod 755 "$pkgdir/usr/bin/ds4-run"
    install -Dm755 "$srcdir/synapse-ds4-server" "$pkgdir/usr/bin/synapse-ds4-server"

    # ── Model and disk-KV state directories ───────────────────
    install -dm755 "$pkgdir/var/lib/ds4/kv/server"

    # ── Documentation ─────────────────────────────────────────
    install -Dm644 STRIXHALO.md -t "$pkgdir/usr/share/doc/synapse-ds4-git/"
    install -Dm644 README.md -t "$pkgdir/usr/share/doc/synapse-ds4-git/"
    install -Dm644 MODEL_CARD.md -t "$pkgdir/usr/share/doc/synapse-ds4-git/"
    install -Dm644 AGENT.md -t "$pkgdir/usr/share/doc/synapse-ds4-git/"
    install -Dm644 CONTRIBUTING.md -t "$pkgdir/usr/share/doc/synapse-ds4-git/"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/synapse-ds4-git/LICENSE"
}
