pkgname=synapse-dub
pkgver=0.7.0
pkgrel=1
pkgdesc='ROCm video dubbing pipeline with explicit multi-speaker voice mapping'
arch=('x86_64')
url='https://synapseos.it'
license=('MIT' 'MPL-2.0' 'custom:Wav2Lip-noncommercial')
install=synapse-dub.install
backup=('etc/synapse/dub/config.conf')

