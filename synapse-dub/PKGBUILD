prepare() {
  patch -d "$srcdir/wav2lip" -Np1 < "$srcdir/wav2lip-modern-python.patch"

  find "$srcdir/wav2lip" -type d -name '__pycache__' -prune -exec rm -rf {} +
}

build() {
  local vendor="$srcdir/python-vendor"
  rm -rf "$vendor"
  mkdir -p "$vendor"

  UV_LINK_MODE=copy uv pip install --python /usr/bin/python --target "$vendor" --no-deps \
    'coqui-tts==0.27.5' 'coqpit-config==0.2.2' 'coqui-tts-trainer==0.3.0' \
    'monotonic-alignment-search==0.2.1' 'num2words==0.5.14' 'pysbd==0.3.4' \
    'gruut-ipa==0.13.0' 'gruut-lang-en==2.0.1' 'gruut==2.4.0' \
    'encodec==0.1.1' 'bangla==0.0.5' 'bnnumerizer==0.0.2' \
    'bnunicodenormalizer==0.1.7' 'hangul-romanize==0.1.0' \
    'ko-speech-tools==0.1.0' 'jamo==0.4.1' 'pyannote-audio==4.0.7' \
    'asteroid-filterbanks==0.4.0' 'lightning-utilities==0.15.2' 'lightning==2.6.0' \
    'torchmetrics==1.8.2' 'pyannote-core==6.0.1' 'pyannote-database==6.1.1' \
    'pyannote-metrics==4.0.0' 'pyannote-pipeline==4.0.0' 'optuna==4.9.0' \
    'pyannoteai-sdk==0.3.0' 'pytorch-metric-learning==2.9.0' 'einops==0.8.2' \
    'torch-audiomentations==0.12.0' 'julius==0.2.8' \
    'torch-pitch-shift==1.2.5' 'primePy==1.3'

  sed -i 's/from transformers.pytorch_utils import isin_mps_friendly as isin/from torch import isin/' \
    "$vendor/TTS/tts/layers/tortoise/autoregressive.py"
  rm -rf "$vendor/bin" "$vendor/.lock"
}

package() {
  local appdir="$pkgdir/usr/lib/synapse-dub"
  local backenddir="$pkgdir/opt/synapse-dub/backends"

  install -dm755 "$appdir/synapse_dub" "$appdir/python" "$backenddir"
  cp -a "$srcdir/python-vendor/." "$appdir/python/"
  install -Dm644 "$startdir/synapse_dub/__init__.py" "$appdir/synapse_dub/__init__.py"
  install -Dm644 "$startdir/synapse_dub/cli.py" "$appdir/synapse_dub/cli.py"
  install -Dm644 "$startdir/sitecustomize.py" "$appdir/sitecustomize.py"

  cp -a "$srcdir/wav2lip" "$backenddir/wav2lip"
  find "$backenddir" -type d -name .git -prune -exec rm -rf {} +
  find "$backenddir" -type d -name '__pycache__' -prune -exec rm -rf {} +

  install -Dm755 "$srcdir/synapse-dub" "$pkgdir/usr/bin/synapse-dub"
  install -Dm755 "$srcdir/synapse-dub-models" "$pkgdir/usr/bin/synapse-dub-models"
  install -Dm644 "$srcdir/config.conf" "$pkgdir/etc/synapse/dub/config.conf"
  install -dm755 "$pkgdir/var/lib/synapse/dub/models"

  install -Dm644 "$srcdir/README.synapse.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 "$startdir/WORKFLOWS.md" "$pkgdir/usr/share/doc/$pkgname/WORKFLOWS.md"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/wav2lip/README.md" "$pkgdir/usr/share/licenses/$pkgname/WAV2LIP-NOTICE.md"
}
