  'synapse-dub-models'
  'synapse-dub.install'
  'README.synapse.md'
  'LICENSE'
)
sha256sums=('4bc8608597f3c31ec23ad7252134425f2b2ce777bf28df2623422f4b2649fe5b'
            '484c4d738df674b54fecbd75ee0c40ed01ab9c28daa3b7f086a0e523c76d2e16'
            '4c173e75724742dc1999983232dd9025490f01f97fe88d358f48c1e2bf1abf2f'
            '93ec0823629a9b120152e721858344308d8221cf2df398a2e1eda665568b4a4e'
