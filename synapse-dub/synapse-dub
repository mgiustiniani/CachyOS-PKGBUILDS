#!/usr/bin/env bash
set -euo pipefail
python=/usr/bin/python
export PYTHONPATH="/usr/lib/synapse-dub:/usr/lib/synapse-dub/python${PYTHONPATH:+:$PYTHONPATH}"
model_root=$(awk -F= '$1 == "MODEL_ROOT" { print substr($0, index($0, "=") + 1); exit }' /etc/synapse/dub/config.conf 2>/dev/null || true)
model_root=${model_root:-/var/lib/synapse/dub/models}
export TTS_HOME="${TTS_HOME:-$model_root/coqui}"
exec "$python" -m synapse_dub.cli "$@"
