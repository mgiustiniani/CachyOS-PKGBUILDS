#!/usr/bin/env bash
set -euo pipefail

runtime_home=${XDG_DATA_HOME:-$HOME/.local/share}/synapse-dub
venv=$runtime_home/venv
export PYTHONPATH="/usr/lib/synapse-dub${PYTHONPATH:+:$PYTHONPATH}"
command=${1:-setup}

case "$command" in
  reset)
    rm -rf "$venv"
    echo "Removed $venv"
    exit 0
    ;;
  status)
    if [[ -x "$venv/bin/python" ]]; then
      "$venv/bin/python" - <<'PY'
mods = ["torchaudio", "TTS", "pyannote.audio"]
for name in mods:
    try:
        __import__(name)
        print(f"PASS {name}")
    except Exception as exc:
        print(f"FAIL {name}: {exc}")
PY
    else
      echo "Runtime not initialized: $venv"
      exit 1
    fi
    exit 0
    ;;
  setup) ;;
  *) echo "Usage: synapse-dub-runtime [setup|status|reset]" >&2; exit 2 ;;
esac

mkdir -p "$runtime_home"
uv venv --system-site-packages --clear "$venv"

# CachyOS currently has no python-torchaudio package. XTTS and pyannote use only
# its Python resampling/feature APIs, so install those modules without loading a
# version-specific C++ extension against the system ROCm PyTorch build.
if ! "$venv/bin/python" -c 'import torchaudio' >/dev/null 2>&1; then
  wheel='https://download-r2.pytorch.org/whl/rocm7.1/torchaudio-2.11.0%2Brocm7.1-cp314-cp314-manylinux_2_28_x86_64.whl'
  UV_LINK_MODE=copy uv pip install --python "$venv/bin/python" --no-deps "$wheel"
  extension="$venv/lib/python3.14/site-packages/torchaudio/_extension/__init__.py"
  sed -i 's/_IS_TORCHAUDIO_EXT_AVAILABLE = _load_lib("_torchaudio")/_IS_TORCHAUDIO_EXT_AVAILABLE = False/' "$extension"
  rm -rf "$venv/lib/python3.14/site-packages/torchaudio/lib"
fi

# Only projects unavailable as stable CachyOS packages are installed here.
# --no-deps is intentional: system packages declared by synapse-dub must never
# be duplicated in this venv. Each missing leaf is explicit and version-pinned.
while IFS='|' read -r module spec; do
  [[ -n "$module" && "$module" != \#* ]] || continue
  if "$venv/bin/python" -c "import $module" >/dev/null 2>&1; then
    printf 'system/previous runtime satisfies %-32s\n' "$module"
  else
    printf 'installing missing runtime %-32s %s\n' "$module" "$spec"
    UV_LINK_MODE=copy uv pip install --python "$venv/bin/python" --no-deps "$spec"
  fi
done <<'PACKAGES'
TTS|coqui-tts==0.27.5
coqpit|coqpit-config==0.2.2
trainer|coqui-tts-trainer==0.3.0
monotonic_alignment_search|monotonic-alignment-search==0.2.1
num2words|num2words==0.5.14
pysbd|pysbd==0.3.4
gruut_ipa|gruut-ipa==0.13.0
gruut_lang_en|gruut-lang-en==2.0.1
gruut|gruut==2.4.0
docopt|docopt==0.6.2
encodec|encodec==0.1.1
bangla|bangla==0.0.5
bnnumerizer|bnnumerizer==0.0.2
bnunicodenormalizer|bnunicodenormalizer==0.1.7
hangul_romanize|hangul-romanize==0.1.0
ko_speech_tools|ko-speech-tools==0.1.0
jamo|jamo==0.4.1
jieba|jieba==0.42.1
pypinyin|pypinyin==0.55.0
pyannote.audio|pyannote-audio==4.0.7
asteroid_filterbanks|asteroid-filterbanks==0.4.0
lightning_utilities|lightning-utilities==0.15.2
lightning|lightning==2.6.0
torchmetrics|torchmetrics==1.8.2
pyannote.core|pyannote-core==6.0.1
pyannote.database|pyannote-database==6.1.1
pyannote.metrics|pyannote-metrics==4.0.0
pyannote.pipeline|pyannote-pipeline==4.0.0
optuna|optuna==4.9.0
pyannoteai_sdk|pyannoteai-sdk==0.3.0
pytorch_metric_learning|pytorch-metric-learning==2.9.0
einops|einops==0.8.2
torch_audiomentations|torch-audiomentations==0.12.0
julius|julius==0.2.8
torch_pitch_shift|torch-pitch-shift==1.2.5
primePy|primePy==1.3
PACKAGES

# Transformers 5 removed this helper; torch.isin has the same behavior needed
# by the Coqui tortoise layer and works with the system ROCm PyTorch build.
coqui_autoregressive="$venv/lib/python3.14/site-packages/TTS/tts/layers/tortoise/autoregressive.py"
sed -i 's/from transformers.pytorch_utils import isin_mps_friendly as isin/from torch import isin/' "$coqui_autoregressive"

echo
"$venv/bin/python" -m synapse_dub.cli doctor || true
echo
printf 'Runtime created at %s\n' "$venv"
printf 'Review /etc/synapse/dub/config.conf, then run synapse-dub doctor.\n'
