post_install() {
  cat <<'MSG'

Synapse Dub installed with its complete Python runtime.

Model weights are external to the pacman package. When selected in Calamares,
the Server Setup page records the required non-commercial license acceptance
and either downloads or validates the models during installation.

For a manual installation, review /etc/synapse/dub/config.conf and then run:

  sudo synapse-dub-models --backend all --accept-noncommercial
  synapse-dub doctor

MSG
}

post_upgrade() {
  post_install
}
