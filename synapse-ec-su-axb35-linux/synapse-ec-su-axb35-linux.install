pre_install() {
    rmmod ec_su_axb35 2>/dev/null || true
}

post_install() {
    echo "synapse-ec-su-axb35-linux: DKMS module and C tools installed."
    echo "DKMS builds ec_su_axb35 for each installed kernel."

    depmod -a
    systemctl daemon-reload
    systemctl enable axb35-fan-control.service 2>/dev/null || true

    if grep -qx AXB35-02 /sys/class/dmi/id/board_name 2>/dev/null; then
        echo "AXB35 service enabled; it will load the driver after DKMS completes."
    elif grep -Eq "ROG Flow Z13|GZ30[12]" /sys/class/dmi/id/product_name 2>/dev/null; then
        echo "Z13 service enabled; no external kernel module is required."
    else
        echo "Unsupported system detected; the policy service will be skipped."
    fi
}

pre_upgrade() {
    pre_install
}

post_upgrade() {
    post_install
}

pre_remove() {
    systemctl disable --now axb35-fan-control.service 2>/dev/null || true
    rmmod ec_su_axb35 2>/dev/null || true
}

post_remove() {
    echo "synapse-ec-su-axb35-linux: package removed."
    systemctl daemon-reload
    depmod -a
}
