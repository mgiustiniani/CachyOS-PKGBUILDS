post_install() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  echo 'Enable automatic queued transfers with:'
  echo '  systemctl enable --now synapse-model-worker.path synapse-model-worker.service'
}

post_upgrade() {
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl try-restart synapse-model-worker.path >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now synapse-model-worker.path synapse-model-worker.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
