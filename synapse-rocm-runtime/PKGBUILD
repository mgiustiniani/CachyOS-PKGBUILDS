pkgname=synapse-rocm-runtime
pkgver=7.2.4
pkgrel=1
pkgdesc='Validated system ROCm and optimized PyTorch runtime for Synapse applications'
arch=('x86_64')
url='https://github.com/mgiustiniani/CachyOS-PKGBUILDS'
license=('GPL-3.0-only')
depends=(
  'glibc>=2.44'
  'linux-firmware-amdgpu'
  'rocm-core>=7.2.4'
  'hip-runtime-amd>=7.2.4'
  'hsa-rocr>=7.2.4'
  'comgr>=2:7.2.4'
  'rocminfo>=7.2.4'
  'rocm-smi-lib>=7.2.0'
  'python'
  'python-pytorch-opt-rocm>=2.13.0'
)
optdepends=('synapse-strixhalo-config: Strix Halo unified-memory kernel tuning')
source=('synapse-rocm-doctor' 'README.md')
sha256sums=('cf0316a7572f0dac635585e604f46e836fd5b86c27f746744c6754deb964db81'
            'dc06986d19ef387a7abe4e4f1f56604889369c5b60411319e51cfa800c069833')

check() {
  python -m py_compile "$srcdir/synapse-rocm-doctor"
}

package() {
  install -Dm755 "$srcdir/synapse-rocm-doctor" "$pkgdir/usr/bin/synapse-rocm-doctor"
  install -Dm644 "$srcdir/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
