# Maintainer: CachyOS <synapse-structurizr-onpremises>
# Contributor: Andrea "KJ" Perrucci

pkgname=synapse-structurizr-onpremises
pkgver=2025.11.09
pkgrel=1
pkgdesc="Structurizr on-premises - A WAR-based deployment of Structurizr for visualizing C4 model diagrams"
arch=('any')
url="https://structurizr.com"
license=('Apache-2.0')
depends=('java-runtime>=11' 'tomcat10')
makedepends=('unzip')
source=("https://github.com/structurizr/onpremises/releases/download/v${pkgver}/structurizr-onpremises.war")
sha256sums=('eaa887ce81a6187f29f36d96a836d73f9af8279eee38295e1a28bcac3c2c85ae')
noextract=('structurizr-onpremises.war')

package() {
    cd "$srcdir"
    install -Dm644 structurizr-onpremises.war "$pkgdir/usr/share/java/structurizr/structurizr.war"
    # Crea un link simbolico dalla webapp di Tomcat al file WAR
    install -d "$pkgdir/usr/share/tomcat10/webapps"
    ln -sf /usr/share/java/structurizr/structurizr.war "$pkgdir/usr/share/tomcat10/webapps/structurizr.war"
    # Crea un file di servizio systemd per avviare Tomcat con la webapp deployata
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/structurizr.service" <<'SERVEOF'
[Unit]
Description=Structurizr C4 model diagramming tool (Tomcat deployment)
After=network.target

[Service]
Type=forking
PIDFile=/var/run/tomcat10.pid
Environment=CATALINA_PID=/var/run/tomcat10.pid
Environment=TOMCAT_JAVA_HOME=/usr/lib/jvm/default-runtime
Environment=CATALINA_HOME=/usr/share/tomcat10
Environment=CATALINA_BASE=/usr/share/tomcat10
Environment=CATALINA_OPTS=
Environment=ERRFILE=SYSLOG
Environment=OUTFILE=SYSLOG

ExecStart=/usr/bin/jsvc \
            -Dcatalina.home=${CATALINA_HOME} \
            -Dcatalina.base=${CATALINA_BASE} \
            -Djava.io.tmpdir=/var/tmp/tomcat10/temp \
            -cp /usr/share/java/commons-daemon.jar:/usr/share/java/eclipse-ecj.jar:${CATALINA_HOME}/bin/bootstrap.jar:${CATALINA_HOME}/bin/tomcat-juli.jar \
            -user tomcat10 \
            -java-home ${TOMCAT_JAVA_HOME} \
            -pidfile /var/run/tomcat10.pid \
            -errfile ${ERRFILE} \
            -outfile ${OUTFILE} \
            $CATALINA_OPTS \
            org.apache.catalina.startup.Bootstrap

ExecStop=/usr/bin/jsvc \
            -pidfile /var/run/tomcat10.pid \
            -stop \
            org.apache.catalina.startup.Bootstrap

[Install]
WantedBy=multi-user.target
SERVEOF
    chmod 644 "$pkgdir/usr/lib/systemd/system/structurizr.service"
}
