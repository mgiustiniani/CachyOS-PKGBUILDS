pkgname=synapse-translate-rocm
pkgver=0.2.0
pkgrel=1
pkgdesc='Local SeamlessM4T specialist speech translation server for ROCm'
arch=('x86_64')
url='https://github.com/mgiustiniani/CachyOS-PKGBUILDS'
license=('Apache-2.0' 'CC-BY-NC-4.0')
depends=(
  'bash' 'rsync' 'python' 'python-pytorch-opt-rocm' 'synapse-python-hf-compat'
  'python-fastapi' 'uvicorn' 'python-pydantic'
  'python-numpy' 'python-scipy' 'python-soundfile' 'python-huggingface-hub' 'rocm-core'
)
makedepends=('uv')
install=synapse-translate.install
backup=('etc/synapse/translate.conf')
source=(
  'synapse-translate-server' 'synapse-translate-models' 'translate.conf'
  'synapse-translate.service' 'synapse-translate.socket'
  'synapse-translate.sysusers' 'synapse-translate.tmpfiles'
  'synapse-translate.install' 'README.md' 'LICENSE'
)
sha256sums=('fa326e1c1ef02f1f506ccfe4e1f09f52274b46e8a7b04ea9ba720b7b511bea97'
            'f938b85eaf2c8c88072c31aa1a51a8ac5f8e1e122576987ab003cd69558eebcb'
            '3b2b59e6d0cee1c75158d5938b1f6c2fd8acc3180bfe3f3ad2c506bb3066561e'
            '718280ca5936481eec3daf3affd9520513dbb0b1876a4a753d7efd14c99c5406'
            '5a3ec275ebf5e8dd20ed477451b65d887e5faa1ae5baf2eb4360eeeb52942718'
            'd53ffa80d5c83b434158636b501c8e2e7caafcc1b29fc67725c673bcb04d9458'
            'b42ef8faac7845518af49410f9c400971f236274660a789ff5213e64665e3482'
            '511cbee5f93e476a6bda061f6a58ed64e2fb2ea562a370781bbec207eaab153b'
            'b5ffa4151d91fa33705aacf7a8a3f0c8541d44e6c703374e6c5ffeec6719b6b3'
            'c7f1127c1c34ed75055a30abb44a215d2717fabbdaaa40bcf9b4404626031c29')

build() {
  rm -rf runtime
  uv pip install --python /usr/bin/python --target runtime --no-deps 'python-multipart==0.0.22'
}

package() {
  install -Dm755 synapse-translate-server "$pkgdir/usr/bin/synapse-translate-server"
  install -Dm755 synapse-translate-models "$pkgdir/usr/bin/synapse-translate-models"
  install -Dm644 translate.conf "$pkgdir/etc/synapse/translate.conf"
  install -Dm644 synapse-translate.service "$pkgdir/usr/lib/systemd/system/synapse-translate.service"
  install -Dm644 synapse-translate.socket "$pkgdir/usr/lib/systemd/system/synapse-translate.socket"
  install -Dm644 synapse-translate.sysusers "$pkgdir/usr/lib/sysusers.d/synapse-translate.conf"
  install -Dm644 synapse-translate.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/synapse-translate.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/lib/$pkgname/python" "$pkgdir/usr/lib/$pkgname"
  cp -a runtime/. "$pkgdir/usr/lib/$pkgname/python/"
  cp -a "$startdir/synapse_translate" "$pkgdir/usr/lib/$pkgname/"
  find "$pkgdir/usr/lib/$pkgname" -type d -name __pycache__ -prune -exec rm -rf {} +
  install -d -m0755 "$pkgdir/var/lib/synapse/translate/models"
}
