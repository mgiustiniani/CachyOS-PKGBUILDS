[Unit]
Description=Synapse ROCm specialist translation server
After=network-online.target synapse-translate.socket
Wants=network-online.target
Requires=synapse-translate.socket

[Service]
Type=simple
User=synapse-translate
Group=synapse-translate
SupplementaryGroups=video render
EnvironmentFile=-/etc/synapse/translate.conf
Environment=HOME=/var/cache/synapse-translate
Environment=XDG_CACHE_HOME=/var/cache/synapse-translate
CacheDirectory=synapse-translate
Sockets=synapse-translate.socket
ExecStart=/usr/bin/synapse-translate-server serve --fd 3
Restart=on-failure
RestartSec=5
TimeoutStartSec=900
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/synapse/translate/models
