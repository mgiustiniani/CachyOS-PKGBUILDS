  'gcc'
  'cmake'
  'ninja'
  'python-pip'
  'python-setuptools'
  'python-wheel'
  'eigen'
  'rocm-hip-sdk'
  'hip-runtime-amd'
  'rocm-core'
  'rocm-cmake'
  'comgr'
)

_rocm_ref_commit='ee7be9e7b646eaefc761f9efc47ac96e7b9ee6ce'
_cumesh_commit='2ef5f9d121e460d1aca9fd8cadb9264d6fa94ba4'
_cubvh_commit='ce92267a24ef6ad7d2c8ccbc2ae2c021a6597e70'
_flexgemm_commit='2a92675f85027f66c7108381a5c0312b7b393310'
_ovoxel_commit='c4c8505c624c0e13a730ff1fd16e84f88837eb77'
_nvdiffrast_commit='d29892337190f7e55f891b319d1daa6686bb681c'
_nvdiffrec_commit='a762dedf4aa049ce777ef8f453098d95f701e6c1'

source=(
  "trellis2-rocm-${_rocm_ref_commit}.tar.gz::https://github.com/Cardboard-box-a/TRELLIS.2_rocm/archive/${_rocm_ref_commit}.tar.gz"
  "cumesh-${_cumesh_commit}.tar.gz::https://github.com/Cardboard-box-a/CuMesh/archive/${_cumesh_commit}.tar.gz"
  "cubvh-${_cubvh_commit}.tar.gz::https://github.com/JeffreyXiang/cubvh/archive/${_cubvh_commit}.tar.gz"
  "flexgemm-rocm-${_flexgemm_commit}.tar.gz::https://github.com/Cardboard-box-a/FlexGEMM-rocm/archive/${_flexgemm_commit}.tar.gz"
  "o-voxel-${_ovoxel_commit}.tar.gz::https://github.com/Cardboard-box-a/o-voxel/archive/${_ovoxel_commit}.tar.gz"
  "nvdiffrast-hip-${_nvdiffrast_commit}.tar.gz::https://github.com/Cardboard-box-a/nvdiffrast-hip/archive/${_nvdiffrast_commit}.tar.gz"
  "nvdiffrec-${_nvdiffrec_commit}.tar.gz::https://github.com/Cardboard-box-a/nvdiffrec/archive/${_nvdiffrec_commit}.tar.gz"
  'models.conf'
  'trellis2-env.sh'
  'download_models.py'
  'preprocess_image.py'
  'trellis2-image-to-3d.py'
  'apply_runtime_patches.py'
  'trellis2-image-to-3d'
  'trellis2-preprocess'
  'trellis2-download-models'
  'README.synapse.md'
)
sha256sums=(
