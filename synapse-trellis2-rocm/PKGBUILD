# Maintainer: Mario Giustiniani <mariogiustiniani@gmail.com>
# Synapse/CachyOS integration package for TRELLIS.2 ROCm on Strix Halo.
#
# NOTE: packaging draft from the validated standard setup. It vendors the missing
# Python deps and ROCm extension stack into /usr/lib/synapse-trellis2-rocm/python
# to avoid a chain of moving *-git dependency packages.

pkgname=synapse-trellis2-rocm
pkgver=0.1.0
pkgrel=1
pkgdesc='Synapse TRELLIS.2 ROCm/gfx1151 integration with configurable model downloader'
arch=('x86_64')
url='https://github.com/Cardboard-box-a/TRELLIS.2_rocm'
license=('MIT')
install=synapse-trellis2-rocm.install
backup=('etc/synapse/trellis2-rocm/models.conf')

depends=(
  'python'
  'python-pytorch-opt-rocm'
  'python-torchvision'
  'python-transformers'
  'python-tokenizers'
  'python-huggingface-hub'
  'python-triton'
  'python-aotriton'
  'python-numpy'
  'python-scipy'
  'python-pillow'
  'python-opencv'
  'python-imageio'
  'python-imageio-ffmpeg'
  'python-trimesh'
  'python-safetensors'
  'python-zstandard'
  'python-pandas'
  'python-tqdm'
  'rocminfo'
  'rocm-core'
)
