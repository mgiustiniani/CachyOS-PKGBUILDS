post_install() {
  cat <<'MSG'

TRELLIS.2 ROCm installed.

Model weights are not part of the package payload. The installer now attempts
to download them into the configured external cache using:

  /usr/bin/trellis2-download-models

Config/mirror file:

  /etc/synapse/trellis2-rocm/models.conf

Default model cache:

  /var/lib/synapse/trellis2/models

Set TRELLIS2_SKIP_MODEL_DOWNLOAD=1 in the environment to skip the automatic
model download and run trellis2-download-models later.

MSG

  if [ "${TRELLIS2_SKIP_MODEL_DOWNLOAD:-0}" != "1" ] && [ -x /usr/bin/trellis2-download-models ]; then
    echo "[trellis2-rocm] downloading model weights..."
    /usr/bin/trellis2-download-models || {
      echo "[trellis2-rocm] warning: model download failed; edit /etc/synapse/trellis2-rocm/models.conf and run trellis2-download-models manually" >&2
      return 0
    }
  fi
}

post_upgrade() {
  post_install
}
