pkgname=synapse-video-gen-rocm
pkgver=0.1.0
pkgrel=2
pkgdesc='Install-ready Wan2.1 VACE generative video backend for system ROCm PyTorch'
arch=('x86_64')
url='https://github.com/mgiustiniani/CachyOS-PKGBUILDS'
license=('Apache-2.0')
depends=(
  'bash'
  'ffmpeg'
  'python'
  'python-pytorch-opt-rocm'
  'synapse-python-hf-compat'
  'python-opencv'
  'python-numpy'
  'python-pillow'
  'python-imageio-ffmpeg'
  'python-safetensors'
  'python-requests'
  'python-regex'
  'python-packaging'
  'python-filelock'
  'python-psutil'
  'python-yaml'
  'python-fsspec'
  'python-tqdm'
  'python-typing_extensions'
  'python-huggingface-hub'
  'rocm-core'
)
makedepends=('uv')
install=synapse-video-gen.install
backup=('etc/synapse/video-gen.conf')
source=(
  'synapse-video-gen'
  'synapse-video-gen-models'
  'video-gen.conf'
  'synapse-video-gen.install'
  'README.md'
  'LICENSE'
)
sha256sums=('4fd6548832b5fc12ca8fef7f02b9270411cdd6bc7b7dd88f3961b6bbbff7f93b'
            '34df3082a1b23519cd45d830157f86c5ed26e843a2cad5e2c568a8d109d90f62'
            '62c00c2c5c69d0587b369a1f5773a8e9fa3a146afe236873e3906f5c6cd14dc6'
            '1a454a80a833b68a4e9580986d293e658dbb7ef940fc9916da1496b06f12581e'
            '135005fb15c31d8991ba88208a41fc1ad6e8b43e9c81825dbee1da57ca995766'
            'd1947b079f75c7cb3f62ed72f6be8e4b5656e7d67889113c0ae1a22f8a93b0f8')

build() {
  rm -rf runtime
  uv pip install --python /usr/bin/python --target runtime --no-deps \
    'diffusers==0.39.0' \
    'ftfy==6.3.1'
  python -m compileall -q runtime "$startdir/synapse_video_gen"
}

package() {
  install -Dm755 synapse-video-gen "$pkgdir/usr/bin/synapse-video-gen"
  install -Dm755 synapse-video-gen-models "$pkgdir/usr/bin/synapse-video-gen-models"
  install -Dm644 video-gen.conf "$pkgdir/etc/synapse/video-gen.conf"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -d "$pkgdir/usr/lib/$pkgname/python" "$pkgdir/usr/lib/$pkgname"
  cp -a runtime/. "$pkgdir/usr/lib/$pkgname/python/"
  cp -a "$startdir/synapse_video_gen" "$pkgdir/usr/lib/$pkgname/"
  find "$pkgdir/usr/lib/$pkgname" -type d -name __pycache__ -prune -exec rm -rf {} +
  install -d -m0755 "$pkgdir/var/lib/synapse/video-gen/models"
}
