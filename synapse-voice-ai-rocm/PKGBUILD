pkgname=synapse-voice-ai-rocm
pkgver=0.1.0
pkgrel=3
pkgdesc='Local multilingual voice cloning, TTS, and Whisper ASR for Synapse Linux ROCm systems'
arch=('x86_64')
url='https://github.com/resemble-ai/chatterbox'
license=('MIT')
install=synapse-voice-ai-rocm.install
backup=('etc/synapse/voice-ai/models.conf')

depends=(
  'python'
  'python-pytorch-opt-rocm'
  'python-transformers'
  'python-tokenizers'
  'python-librosa'
  'python-numpy'
  'python-scipy'
  'python-soundfile'
  'python-omegaconf'
  'python-pykakasi'
  'python-huggingface-hub'
  'python-fastapi'
  'python-httpx'
  'python-onnx'
  'python-tqdm'
  'ffmpeg'
  'whisper-cpp'
  'ggml-rocm'
  'rocm-core'
)
makedepends=('uv' 'gcc' 'python-setuptools')

_torchaudio_wheel='torchaudio-2.11.0+rocm7.1-cp314-cp314-manylinux_2_28_x86_64.whl'
source=(
  "${_torchaudio_wheel}::https://download-r2.pytorch.org/whl/rocm7.1/torchaudio-2.11.0%2Brocm7.1-cp314-cp314-manylinux_2_28_x86_64.whl"
  'models.conf'
  'chatterbox-local-models.patch'
  'torchaudio-extension-free.patch'
  'synapse-voice-api'
  'synapse-voice-tts'
  'synapse-voice-transcribe'
  'synapse-voice-enroll'
  'synapse-voice-import-models'
  'synapse-voice-api.service'
  'synapse-voice-ai-rocm.install'
  'README.synapse.md'
)
