build() {
  local vendor="$srcdir/python-vendor"
  rm -rf "$vendor"
  mkdir -p "$vendor"

  UV_LINK_MODE=copy uv pip install --python /usr/bin/python --target "$vendor" --no-deps \
    'chatterbox-tts==0.1.7' \
    's3tokenizer==0.3.0' \
    'resemble-perth==1.0.1' \
    'conformer==0.3.2' \
    'spacy-pkuseg==1.0.1' \
    'srsly==2.5.2' \
    'pyloudnorm==0.2.0' \
    'diffusers==0.29.0' \
    'einops==0.8.2' \
    'safetensors==0.5.3' \
    'tokenizers==0.22.2' \
    'uvicorn==0.41.0' \
    'python-multipart==0.0.22' \
    'click==8.4.2' \
    'h11==0.16.0'

  patch -l -d "$vendor" -p1 < "$srcdir/chatterbox-local-models.patch"
  bsdtar -xf "$srcdir/${_torchaudio_wheel}" -C "$vendor"
  patch -d "$vendor" -p1 < "$srcdir/torchaudio-extension-free.patch"
  rm -rf "$vendor/bin" "$vendor/.lock" "$vendor/torchaudio/lib"
}

package() {
  local appdir="$pkgdir/usr/lib/synapse-voice-ai"

  install -dm755 "$appdir/python" "$appdir/synapse_voice"
  cp -a "$srcdir/python-vendor/." "$appdir/python/"
  install -Dm644 "$startdir/synapse_voice/__init__.py" "$appdir/synapse_voice/__init__.py"
  install -Dm644 "$startdir/synapse_voice/config.py" "$appdir/synapse_voice/config.py"
  install -Dm644 "$startdir/synapse_voice/engine.py" "$appdir/synapse_voice/engine.py"
  install -Dm644 "$startdir/synapse_voice/api.py" "$appdir/synapse_voice/api.py"
  install -Dm644 "$startdir/synapse_voice/cli.py" "$appdir/synapse_voice/cli.py"
  install -Dm644 "$startdir/synapse_voice/import_models.py" "$appdir/synapse_voice/import_models.py"

  install -Dm644 "$srcdir/models.conf" "$pkgdir/etc/synapse/voice-ai/models.conf"
  install -Dm755 "$srcdir/synapse-voice-api" "$pkgdir/usr/bin/synapse-voice-api"
  install -Dm755 "$srcdir/synapse-voice-tts" "$pkgdir/usr/bin/synapse-voice-tts"
  install -Dm755 "$srcdir/synapse-voice-transcribe" "$pkgdir/usr/bin/synapse-voice-transcribe"
  install -Dm755 "$srcdir/synapse-voice-enroll" "$pkgdir/usr/bin/synapse-voice-enroll"
  install -Dm755 "$srcdir/synapse-voice-import-models" "$pkgdir/usr/bin/synapse-voice-import-models"
  install -Dm644 "$srcdir/synapse-voice-api.service" "$pkgdir/usr/lib/systemd/user/synapse-voice-api.service"

  install -dm755 "$pkgdir/var/lib/synapse/voice-ai/models"
  install -Dm644 "$srcdir/README.synapse.md" "$pkgdir/usr/share/doc/$pkgname/README.md"

  local license_file
  license_file=$(find "$srcdir/python-vendor" -path '*chatterbox_tts-*.dist-info/licenses/LICENSE' -print -quit)
  if [[ -n "$license_file" ]]; then
    install -Dm644 "$license_file" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
