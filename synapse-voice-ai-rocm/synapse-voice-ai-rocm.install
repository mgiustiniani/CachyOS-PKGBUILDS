post_install() {
  cat <<'MSG'

Synapse Voice AI ROCm installed.

Model weights are intentionally external to the package and ISO. Mount the
filesystem labelled "models" and validate it with:

  synapse-voice-import-models

To copy the selected Chatterbox and Whisper models into local storage:

  sudo synapse-voice-import-models --copy

Enable the per-user API after logging in:

  systemctl --user enable --now synapse-voice-api.service

MSG
}

post_upgrade() {
  post_install
}
