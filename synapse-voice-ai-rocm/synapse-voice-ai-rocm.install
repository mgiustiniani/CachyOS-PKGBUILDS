post_install() {
  cat <<'MSG'

Synapse Voice AI ROCm installed.

Model weights are intentionally external to the package and ISO. Calamares
Server Setup can download pinned revisions from the Internet or validate an
external archive. For manual setup, choose one mode:

  sudo synapse-voice-download-models --root /var/lib/synapse/voice-ai/models
  synapse-voice-import-models

Enable the per-user API after logging in:

  systemctl --user enable --now synapse-voice-api.service

MSG
}

post_upgrade() {
  post_install
}
