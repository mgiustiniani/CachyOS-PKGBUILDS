package() {
  install -Dm755 synapse-whisper-xdna "$pkgdir/usr/bin/synapse-whisper-xdna"
  install -Dm755 main.py "$pkgdir/usr/lib/synapse-whisper-xdna/main.py"
  install -Dm644 vitisai_config_whisper_encoder.json \
