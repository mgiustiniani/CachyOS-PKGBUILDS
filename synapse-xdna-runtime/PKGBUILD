pkgname=synapse-xdna-runtime
pkgver=0.2.0
pkgrel=2
pkgdesc='AMD XDNA NPU runtime integration, external SDK importer, validation, and proof tooling'
arch=('x86_64')
url='https://github.com/mgiustiniani/CachyOS-PKGBUILDS'
license=('Apache-2.0')
depends=('python' 'synapse-python312' 'xrt' 'xrt-plugin-amdxdna')
options=('!strip')
install=synapse-xdna-runtime.install
_vtd_commit=c79b5d21568a4ffa5b0612a8279b352fc4e1109a
source=(
  "xrt_smi_strx.a::https://github.com/Xilinx/VTD/raw/${_vtd_commit}/archive/strx/xrt_smi_strx.a"
  'synapse-xdna'
  'synapse-xdna-import'
  '99-amdxdna.conf'
  'README.md'
)
noextract=('xrt_smi_strx.a')
sha256sums=(
  '57384f0d5cf3fc604b00540ed9b7542826cd961c30a2f3207357c972cc3ef32c'
  '96e942794a752c3e3c1d58d15337e1d9512eba316538832db09899159492982a'
  '48637626680214635a437329705aab9cfc7dea45782aa185101165d9dafe8040'
  '25855b5063a1b8c17b520ca6fd87d53bb78308a6bbe877f50065de97437a7f7d'
  '76f71461834168e588a29cb4761976527bdbd7a2b8905a6991d4dd74966c66cc'
)

package() {
  install -Dm644 xrt_smi_strx.a \
    "$pkgdir/usr/share/xrt/amdxdna/bins/xrt_smi_strx.a"
  install -Dm755 synapse-xdna "$pkgdir/usr/bin/synapse-xdna"
  install -Dm755 synapse-xdna-import "$pkgdir/usr/bin/synapse-xdna-import"
  install -Dm644 99-amdxdna.conf \
    "$pkgdir/etc/security/limits.d/99-amdxdna.conf"
  install -Dm644 README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
}
