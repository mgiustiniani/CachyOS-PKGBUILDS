#!/usr/bin/env python3
"""Diagnose and prove AMD XDNA NPU execution through XRT."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import resource
import shutil
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

ARCHIVE = Path("/usr/share/xrt/amdxdna/bins/xrt_smi_strx.a")
ARCHIVE_SHA256 = "57384f0d5cf3fc604b00540ed9b7542826cd961c30a2f3207357c972cc3ef32c"


def run(command: list[str], timeout: float = 30.0) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, timeout=timeout, check=False)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def json_print(document: dict[str, Any]) -> None:
    print(json.dumps(document, sort_keys=True, separators=(",", ":")))


def available_onnx_providers() -> tuple[list[str], str | None]:
    candidates: list[Path] = []
    configured = os.environ.get("RYZEN_AI_VENV")
    if configured:
        candidates.append(Path(configured) / "bin/python")
    candidates.extend([
        Path("/opt/AMD/ryzenai/venv/bin/python"),
        Path("/opt/synapse/xdna/venv/bin/python"),
        Path(sys.executable),
    ])
    seen: set[Path] = set()
    for python in candidates:
        if python in seen or not python.is_file():
            continue
        seen.add(python)
        probe = run([str(python), "-c", (
            "import json,onnxruntime as ort;"
            "print(json.dumps(ort.get_available_providers()))"
        )])
        if probe.returncode == 0:
            try:
                return json.loads(probe.stdout.strip().splitlines()[-1]), str(python)
            except (json.JSONDecodeError, IndexError):
                pass
    return [], None


def doctor(as_json: bool) -> int:
    soft, hard = resource.getrlimit(resource.RLIMIT_MEMLOCK)
    unlimited = soft == resource.RLIM_INFINITY
    archive_hash = sha256(ARCHIVE) if ARCHIVE.is_file() else None
    archive_valid = archive_hash == ARCHIVE_SHA256
    xrt_smi = shutil.which("xrt-smi")
    examine = run([xrt_smi, "examine", "--batch"], timeout=30) if xrt_smi else None
    examine_output = examine.stdout if examine else ""
    device_present = "RyzenAI-npu" in examine_output
    providers, provider_python = available_onnx_providers()
    vitis_available = "VitisAIExecutionProvider" in providers

    checks = {
        "xrt_smi": bool(xrt_smi),
        "xdna_device": Path("/dev/accel/accel0").exists() and device_present,
        "validation_archive": archive_valid,
        "memlock": unlimited or soft >= 64 * 1024 * 1024,
    }
    platform_ready = all(checks.values())
    result: dict[str, Any] = {
        "schema_version": 1,
        "status": "ready" if platform_ready else "incomplete",
        "platform_ready": platform_ready,
        "onnx_npu_ready": platform_ready and vitis_available,
        "checks": checks,
        "memlock": {
            "soft_bytes": "unlimited" if unlimited else soft,
            "hard_bytes": "unlimited" if hard == resource.RLIM_INFINITY else hard,
        },
        "validation_archive": {
            "path": str(ARCHIVE),
            "sha256": archive_hash,
            "expected_sha256": ARCHIVE_SHA256,
        },
        "onnxruntime": {
            "python": provider_python,
            "providers": providers,
            "vitis_ai_execution_provider": vitis_available,
        },
    }
    if as_json:
        json_print(result)
    else:
        print(f"XDNA platform: {'READY' if platform_ready else 'INCOMPLETE'}")
        for name, passed in checks.items():
            print(f"  {'PASS' if passed else 'FAIL'}  {name}")
        print("ONNX NPU provider: " +
              ("VitisAIExecutionProvider available" if vitis_available else
               "not installed (AMD Ryzen AI SDK 1.7.1 is required)"))
    return 0 if platform_ready else 1


def detect_device() -> str | None:
    probe = run(["xrt-smi", "examine", "--batch"])
    match = re.search(r"\[(?:0x)?([0-9a-fA-F]{4}:[0-9a-fA-F]{2}:[0-9a-fA-F]{2}\.[0-7])\]", probe.stdout)
    return match.group(1) if match else None


def proof(device: str | None, test: str, as_json: bool) -> int:
    device = device or detect_device()
    if not device:
        result = {"schema_version": 1, "status": "failed",
                  "error": "no XDNA device found through xrt-smi"}
        json_print(result) if as_json else print(result["error"], file=sys.stderr)
        return 1
    command = ["xrt-smi", "validate", "-d", device, "-r", test,
               "--batch", "--verbose"]
    started = time.monotonic()
    try:
        validation = subprocess.Popen(command, text=True, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT)
    except FileNotFoundError:
        result = {"schema_version": 1, "status": "failed",
                  "error": "xrt-smi not found"}
        json_print(result) if as_json else print(result["error"], file=sys.stderr)
        return 1

    samples = 0
    active_samples = 0
    first_active: str | None = None
    while validation.poll() is None:
        report = run(["xrt-smi", "examine", "-d", device,
                      "-r", "aie-partitions", "--batch"], timeout=15)
        samples += 1
        if "|Active" in report.stdout:
            active_samples += 1
            if first_active is None:
                first_active = report.stdout

    output = validation.communicate()[0] or ""
    elapsed = time.monotonic() - started
    passed = validation.returncode == 0 and "Test Status" in output and "[PASSED]" in output
    proven = passed and active_samples > 0

    tops_match = re.search(r"TOPS:\s*([0-9.]+)", output)
    latency_match = re.search(r"Average latency:\s*([0-9.]+\s*\w+)", output)
    pid_match = re.search(r"\|\s*(\d+)\s*\|\s*\d+\s*\|", first_active or "")
    columns_match = re.search(r"Columns:\s*\[([^]]+)\]", first_active or "")
    result: dict[str, Any] = {
        "schema_version": 1,
        "status": "proven" if proven else "failed",
        "device": device,
        "test": test,
        "validation_passed": passed,
        "active_context_observed": active_samples > 0,
        "samples": samples,
        "active_context_samples": active_samples,
        "context_pid": int(pid_match.group(1)) if pid_match else None,
        "aie_columns": columns_match.group(1) if columns_match else None,
        "tops": float(tops_match.group(1)) if tops_match else None,
        "average_latency": latency_match.group(1) if latency_match else None,
        "elapsed_seconds": round(elapsed, 3),
        "validation_returncode": validation.returncode,
    }
    if as_json:
        json_print(result)
    else:
        print(f"XDNA NPU execution: {'PROVEN' if proven else 'FAILED'}")
        print(f"  validation: {'passed' if passed else 'failed'}")
        print(f"  active AIE context samples: {active_samples}/{samples}")
        if result["context_pid"] is not None:
            print(f"  context PID: {result['context_pid']}")
        if result["aie_columns"]:
            print(f"  AIE columns: [{result['aie_columns']}]")
        if result["tops"] is not None:
            print(f"  measured INT8 GEMM: {result['tops']:.1f} TOPS")
        if result["average_latency"]:
            print(f"  average latency: {result['average_latency']}")
        if not passed:
            print(output.rstrip(), file=sys.stderr)
    return 0 if proven else 1


def main() -> int:
    parser = argparse.ArgumentParser(prog="synapse-xdna")
    subparsers = parser.add_subparsers(dest="command", required=True)

    doctor_parser = subparsers.add_parser("doctor", help="check the XDNA platform")
    doctor_parser.add_argument("--json", action="store_true")

    proof_parser = subparsers.add_parser("proof", help="run XRT validation and observe an active AIE context")
    proof_parser.add_argument("--device", help="XDNA PCI BDF; auto-detected by default")
    proof_parser.add_argument("--test", choices=("gemm", "latency"), default="gemm")
    proof_parser.add_argument("--json", action="store_true")

    args = parser.parse_args()
    if args.command == "doctor":
        return doctor(args.json)
    return proof(args.device, args.test, args.json)


if __name__ == "__main__":
    raise SystemExit(main())
